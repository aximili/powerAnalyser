# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which provider to use: ollama | glm | openai
LLM_PROVIDER=ollama

# Model name (provider-specific)
#   Ollama examples : llama3.2, qwen2.5, mistral
#   GLM examples    : glm-4, glm-4v (vision-capable, required for screenshot analysis)
#   OpenAI examples : gpt-4o, gpt-4-turbo
LLM_MODEL=llama3.2

# Ollama — runs locally, no key needed
OLLAMA_BASE_URL=http://localhost:11434

# Zhipu AI GLM (https://open.bigmodel.cn)
GLM_API_KEY=

# OpenAI or any OpenAI-compatible server (LM Studio, vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# Maximum number of observe→act cycles before the agent gives up
MAX_AGENT_ITERATIONS=25

# Run browser headlessly (true) or visibly (false).
# Set to false when debugging or when solving CAPTCHAs manually.
AGENT_HEADLESS=false

# ── App Paths ─────────────────────────────────────────────────────────────────
# Directory containing sample plan JSON files
DATA_DIR=data
